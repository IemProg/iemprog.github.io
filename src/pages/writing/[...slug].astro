---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getPosts, readingTime, formatDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const minutes = readingTime(post.body);
---

<Base title={post.data.title} description={post.data.description} type="article">
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="dek">{post.data.description}</p>}
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {minutes} min read
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-end">
      {
        post.data.originalUrl && (
          <p>
            First published on <a href={post.data.originalUrl} rel="noopener">Substack</a>.
          </p>
        )
      }
      <p><a href="/writing/">← All writing</a></p>
    </footer>
  </article>

  <Subscribe />
</Base>
