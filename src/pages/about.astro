---
import Base from '../layouts/Base.astro';
import { EXPERIENCE, EDUCATION } from '../data/experience';
import { THESIS } from '../data/publications';
import Socials from '../components/Socials.astro';
---

<Base title="About" description="About Imad Eddine Marouf, AI researcher and co-founder of CurriboxAI.">
  <div class="about-head">
    <div class="prose-block">
      <h1 class="page-title">About</h1>
      <p>
        I completed my PhD in {THESIS.year} at LTCI, Télécom Paris (Institut Polytechnique de Paris), with a thesis
        titled <em>{THESIS.title}</em>. My papers cover continual learning, model merging and parameter-efficient
        fine-tuning, and are listed on the <a href="/research/">research page</a>.
      </p>
      <p>
        I co-founded <a href="https://curriboxai.com" rel="noopener">CurriboxAI</a>, which makes tools that help
        staffing firms anonymize, translate and format CVs. I review for CVPR, NeurIPS and ECCV, and I publish
        <a href="/writing/">essays</a> here.
      </p>
      <p>
        You can reach me by
        <a href="#" class="email-link" data-u="am.eniddedami" data-d="moc.liamg">email</a>.
      </p>
      <Socials />
    </div>
    <img src="/assets/img/prof_pic_color.jpg" alt="Portrait of Imad Eddine Marouf" width="960" height="960" />
  </div>

  <section class="section">
    <div class="section-head"><h2 class="label">Experience</h2></div>
    <ul class="cv-rows">
      {
        EXPERIENCE.map((r) => (
          <li>
            <span class="meta">{r.when}</span>
            <div>
              <p class="what">
                {r.role}, <span class="org">{r.org}</span>
              </p>
              <p class="d">{r.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head"><h2 class="label">Education</h2></div>
    <ul class="cv-rows">
      {
        EDUCATION.map((e) => (
          <li>
            <span class="meta">{e.when}</span>
            <div>
              <p class="what">{e.what}</p>
              <p class="d">{e.where}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
