---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { EXPERIENCE, EDUCATION } from '../data/experience';
import Socials from '../components/Socials.astro';
---

<Base title="About" description="About Imad Eddine Marouf, AI researcher and co-founder of CurriboxAI.">
  <div class="about-head">
    <div class="prose-block">
      <h1 class="page-title">About</h1>
      <p>
        I'm Imad. I did my PhD at <a href="https://www.telecom-paris.fr/" rel="noopener">Télécom Paris</a>
        (Institut Polytechnique de Paris), advised by <a href="http://stelat.eu/" rel="noopener">Stéphane Lathuilière</a>
        and <a href="https://enzotarta.github.io/" rel="noopener">Enzo Tartaglione</a>. My thesis looked at how to adapt
        large pretrained models to new tasks over time without losing what they already learned.
      </p>
    </div>
    <img src="/assets/img/prof_pic_color.jpg" alt="Portrait of Imad Eddine Marouf" width="288" height="360" />
  </div>

  <div class="prose-block">
    <p>
      During the PhD I spent time at the Computer Vision Center in Barcelona and, more recently, on Google DeepMind's
      Gemma team, working on data mixtures for pre-training. I also co-founded
      <a href="https://curriboxai.com" rel="noopener">CurriboxAI</a>, because I want to see research ideas used in real
      products.
    </p>
    <p>
      I <a href="/writing/">write</a> about research, building companies, and the long game.
    </p>
    <p>
      The best way to reach me is on <a href={SITE.contact} rel="noopener">LinkedIn</a>. I'm happy to talk about
      research, collaborations, or anything I've written.
    </p>
    <Socials />
  </div>

  <section class="section">
    <div class="section-head"><h2 class="label">Experience</h2></div>
    <ul class="cv-rows">
      {
        EXPERIENCE.map((r) => (
          <li>
            <span class="meta">{r.when}</span>
            <div>
              <p class="what">
                {r.role}, <span class="org">{r.org}</span>
              </p>
              <p class="d">{r.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head"><h2 class="label">Education</h2></div>
    <ul class="cv-rows">
      {
        EDUCATION.map((e) => (
          <li>
            <span class="meta">{e.when}</span>
            <div>
              <p class="what">{e.what}</p>
              <p class="d">{e.where}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

</Base>
