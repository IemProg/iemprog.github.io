---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import { PUBLICATIONS } from '../data/publications';
import { NEWS, formatMonth } from '../data/news';
import Paper from '../components/Paper.astro';
import Socials from '../components/Socials.astro';
import { getPosts, formatDate } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
const recentNews = NEWS.slice(0, 5);
const olderNews = NEWS.slice(5);

// Structured data so search engines can connect the profiles to one person.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Imad Eddine Marouf',
  url: 'https://iemprog.github.io/',
  image: 'https://iemprog.github.io/assets/img/prof_pic_color.jpg',
  jobTitle: 'AI Researcher',
  description: 'AI researcher working on continual learning and the adaptation of pretrained vision and vision-language models.',
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Télécom Paris, Institut Polytechnique de Paris' },
    { '@type': 'CollegeOrUniversity', name: 'Sorbonne Université' },
  ],
  knowsAbout: ['Continual learning', 'Vision-language models', 'Model merging', 'Parameter-efficient fine-tuning'],
  sameAs: [
    'https://www.linkedin.com/in/iemprog/',
    'https://scholar.google.com/citations?user=Z6xFbwQAAAAJ',
    'https://github.com/IemProg',
    'https://x.com/ImadMAROUF3',
    'https://imadmarouf.substack.com',
  ],
};
---

<Base>
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
  <section class="hero">
    <div class="hero-text">
      <h1>Imad Eddine Marouf</h1>
      <p>
        I'm an AI researcher working on continual learning: how pretrained models can keep adapting to new tasks
        without forgetting what they already know. I recently completed my PhD at
        <a href="https://www.telecom-paris.fr/" rel="noopener">Télécom Paris</a>, advised by
        <a href="http://stelat.eu/" rel="noopener">Stéphane Lathuilière</a> and
        <a href="https://enzotarta.github.io/" rel="noopener">Enzo Tartaglione</a>. During the PhD I was a student
        researcher on Google DeepMind's Gemma team, working on data mixtures for pre-training, and a visiting
        researcher at the Computer Vision Center in Barcelona, hosted by
        <a href="https://scholar.google.com/citations?user=Gsw2iUEAAAAJ&hl=en" rel="noopener">Joost van de Weijer</a>.
      </p>
      <p>
        I also write about research and what I learn along the way, including from building
        <a href="https://curriboxai.com" rel="noopener">CurriboxAI</a>. I'm open to research roles on LLM and
        vision-language model training:
        <a href="#" class="email-link" data-u="am.eniddedami" data-d="moc.liamg">get in touch</a>.
      </p>
      <Socials />
    </div>
    <img
      class="hero-photo"
      src="/assets/img/prof_pic_color.jpg"
      alt="Portrait of Imad Eddine Marouf"
      width="960"
      height="960"
    />
  </section>

  <section class="section">
    <div class="section-head"><h2 class="label">News</h2></div>
    <ul class="news">
      {
        recentNews.map((n) => (
          <li>
            <time class="meta" datetime={n.date}>{formatMonth(n.date)}</time>
            <span set:html={n.html} />
          </li>
        ))
      }
    </ul>
    {
      olderNews.length > 0 && (
        <details class="more">
          <summary>Show older</summary>
          <ul class="news">
            {olderNews.map((n) => (
              <li>
                <time class="meta" datetime={n.date}>{formatMonth(n.date)}</time>
                <span set:html={n.html} />
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Publications</h2>
      <a href="/research/">Research →</a>
    </div>
    {PUBLICATIONS.map((p) => <Paper p={p} />)}
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Essays</h2>
      <a href="/writing/">All writing →</a>
    </div>
    <ul class="rows">
      {
        posts.map((p) => (
          <li>
            <a href={`/writing/${p.id}/`}>{p.data.title}</a>
            <span class="meta">{formatDate(p.data.date, 'short')}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <Subscribe />
</Base>
