---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../data/site';
import { PUBLICATIONS } from '../data/publications';
import { getPosts, formatDate } from '../lib/posts';

const posts = (await getPosts()).slice(0, 5);
const selected = PUBLICATIONS.filter((p) => p.selected);
---

<Base>
  <section class="hero">
    <h1>I'm an AI researcher. I work on how models can keep learning without forgetting what they already know.</h1>
    <p>
      I recently finished my PhD at Télécom Paris. I also co-founded
      <a href="https://curriboxai.com" rel="noopener">CurriboxAI</a>, and I write here about research, building
      products, and the long game.
    </p>
  </section>

  <section class="section">
    <div class="section-head"><h2 class="label">Now</h2></div>
    <ul class="now">
      <li>
        Open to research roles on LLM and vision-language model training.
        <a href={SITE.contact} rel="noopener">Get in touch.</a>
      </li>
      <li>Building <a href="https://curriboxai.com" rel="noopener">CurriboxAI</a>.</li>
      <li>Writing more often.</li>
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Writing</h2>
      <a href="/writing/">All writing →</a>
    </div>
    <ul class="rows">
      {
        posts.map((p) => (
          <li>
            <a href={`/writing/${p.id}/`}>{p.data.title}</a>
            <span class="meta">{formatDate(p.data.date, 'short')}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Selected research</h2>
      <a href="/research/">All papers →</a>
    </div>
    <ul class="rows">
      {
        selected.map((p) => (
          <li>
            <a href={p.arxiv} rel="noopener">
              {p.title}
            </a>
            <span class="meta">
              {p.short}
              {p.note && <span class="accent"> · Oral</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head"><h2 class="label">Building</h2></div>
    <ul class="rows">
      <li>
        <span>
          <a href="https://curriboxai.com" rel="noopener">CurriboxAI</a>
          <span class="sub">Tools that help staffing firms anonymize, translate and format CVs.</span>
        </span>
        <span class="meta">Co-founder</span>
      </li>
      <li>
        <span>
          <a href="https://github.com/IemProg" rel="noopener">Open-source research code</a>
          <span class="sub">Code for my papers: DMC, QUAD, CoFiMA, PLASTIC.</span>
        </span>
        <span class="meta">GitHub</span>
      </li>
    </ul>
  </section>

  <Subscribe />
</Base>
