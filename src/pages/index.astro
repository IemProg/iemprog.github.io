---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../data/site';
import { PUBLICATIONS } from '../data/publications';
import { NEWS, formatMonth } from '../data/news';
import Paper from '../components/Paper.astro';
import { getPosts, formatDate } from '../lib/posts';

const posts = (await getPosts()).slice(0, 5);
---

<Base>
  <section class="hero">
    <h1>I'm an AI researcher working on continual learning: how pretrained models can keep adapting to new tasks without forgetting what they already know.</h1>
    <p>
      I recently completed my PhD at <a href="https://www.telecom-paris.fr/" rel="noopener">Télécom Paris</a>,
      advised by <a href="http://stelat.eu/" rel="noopener">Stéphane Lathuilière</a> and
      <a href="https://enzotarta.github.io/" rel="noopener">Enzo Tartaglione</a>. My thesis studied efficient ways to
      adapt vision and vision-language models over time. During the PhD I
      was a student researcher on Google DeepMind's Gemma team, working on data mixtures for pre-training, and a
      visiting researcher at the Computer Vision Center in Barcelona, hosted by
      <a href="https://scholar.google.com/citations?user=Gsw2iUEAAAAJ&hl=en" rel="noopener">Joost van de Weijer</a>.
    </p>
    <p>
      I'm interested in what makes models train well: data, adaptation, and compute. Here I write about research and
      what I learn along the way, including from building
      <a href="https://curriboxai.com" rel="noopener">CurriboxAI</a>.
    </p>
    <p>
      I'm open to research roles on LLM and vision-language model training.
      <a href={SITE.contact} rel="noopener">Get in touch</a>.
    </p>
    <ul class="socials">
      <li><a href="https://www.linkedin.com/in/iemprog/" rel="noopener">LinkedIn</a></li>
      <li><a href="https://scholar.google.com/citations?user=Z6xFbwQAAAAJ&hl=fr" rel="noopener">Google Scholar</a></li>
      <li><a href="https://github.com/IemProg" rel="noopener">GitHub</a></li>
      <li><a href="#" id="email-link" data-u="am.eniddedami" data-d="moc.liamg">Email</a></li>
    </ul>
    <script is:inline>
      // The address is stored reversed and assembled only on click, so it never appears in the page.
      document.getElementById('email-link')?.addEventListener('click', function (e) {
        e.preventDefault();
        var r = function (s) { return s.split('').reverse().join(''); };
        window.open('mailto:' + r(this.dataset.u) + '@' + r(this.dataset.d), '_blank');
      });
    </script>
  </section>

  <section class="section">
    <div class="section-head"><h2 class="label">News</h2></div>
    <ul class="news">
      {
        NEWS.map((n) => (
          <li>
            <time class="meta" datetime={n.date}>{formatMonth(n.date)}</time>
            <span set:html={n.html} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Publications</h2>
      <a href="/research/">Research →</a>
    </div>
    {PUBLICATIONS.map((p) => <Paper p={p} />)}
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Writing</h2>
      <a href="/writing/">All writing →</a>
    </div>
    <ul class="rows">
      {
        posts.map((p) => (
          <li>
            <a href={`/writing/${p.id}/`}>{p.data.title}</a>
            <span class="meta">{formatDate(p.data.date, 'short')}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head"><h2 class="label">Building</h2></div>
    <ul class="rows">
      <li>
        <span>
          <a href="https://curriboxai.com" rel="noopener">CurriboxAI</a>
          <span class="sub">Tools that help staffing firms anonymize, translate and format CVs.</span>
        </span>
        <span class="meta">Co-founder</span>
      </li>
    </ul>
  </section>

  <Subscribe />
</Base>
